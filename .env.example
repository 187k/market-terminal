# Copy to .env and fill in. Never commit .env.
# Lines starting with # are comments; keep comments on their own line.

# ---------------------------------------------------------------- runtime
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Human-readable logs for local development (JSON lines when false)
LOG_PRETTY=true

# ---------------------------------------------------------------- infrastructure
# Values below are for running the apps on the host against `docker compose up -d`.
# Inside docker compose the hosts are replaced with the service names automatically.
POSTGRES_USER=mip
POSTGRES_PASSWORD=mip
POSTGRES_DB=mip
# Host port for the Postgres container (5433 because 5432 is often taken by a local install)
POSTGRES_PORT=5433
DATABASE_URL=postgresql://mip:mip@localhost:5433/mip
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------- api / dashboard
# 127.0.0.1 keeps the dev API off the network; docker compose sets 0.0.0.0 inside the container
API_HOST=127.0.0.1
API_PORT=3000
# Host port of the dashboard when running the full docker compose stack
WEB_PORT=8080
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me
# At least 16 characters; signs the session cookie
SESSION_SECRET=replace-with-a-long-random-string
SESSION_TTL_HOURS=168
# Set to true once the dashboard is served over HTTPS
COOKIE_SECURE=false
# Terminal (view-only chart, order book and trades of one instrument). While someone views an
# instrument, the API requests its order book and newest candles from the exchange's public REST
# API this often (milliseconds). Requests share the exchange rate limits and honour bans.
TERMINAL_BOOK_REFRESH_MS=2000
TERMINAL_CANDLE_SYNC_MS=10000

# ---------------------------------------------------------------- exchanges (Stage 3)
# Comma-separated subset of: bybit,binance,mexc,hyperliquid,bitget,bingx,gate
EXCHANGES_ENABLED=bybit,binance,mexc,hyperliquid,bitget,bingx,gate
# Read-only keys only: no trading, no withdrawals.
BYBIT_API_KEY=
BYBIT_API_SECRET=
BINANCE_API_KEY=
BINANCE_API_SECRET=
MEXC_API_KEY=
MEXC_API_SECRET=
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=
BINGX_API_KEY=
BINGX_API_SECRET=
GATE_API_KEY=
GATE_API_SECRET=
# Public trades are streamed to the engine for the TWAP / DCA detector; smaller trades are dropped.
# The terminal's trade list shows the same stream, so it also lists only trades above this value.
TRADES_ENABLED=true
TRADES_MIN_NOTIONAL_USD=500
# Days of per-minute market snapshots kept in PostgreSQL (OI windows, funding settlements)
MARKET_SNAPSHOT_RETENTION_DAYS=7
# Only for networks where MEXC's documented hosts are blocked (e.g. some VPN exits); used by the
# collector, the engine (order books) and the API (terminal candles and order books). Leave empty
# to use https://api.mexc.com and wss://contract.mexc.com/edge. With Cloudflare WARP, excluding
# MEXC from the tunnel is simpler (README, Troubleshooting).
MEXC_REST_URL=
MEXC_WS_URL=

# Days of connection events (collector) and resolved signals (engine) kept in PostgreSQL.
# Signals: at least 8, because restarts restore the last 7 days of signals.
CONNECTION_EVENT_RETENTION_DAYS=30
SIGNAL_RETENTION_DAYS=90

# ---------------------------------------------------------------- instrument universe (Stage 3)
# Number of assets to monitor, and how they are ranked: market_cap (CoinGecko) or volume
UNIVERSE_SIZE=100
UNIVERSE_RANKING=market_cap
UNIVERSE_REFRESH_HOURS=24
# An instrument is mapped to an asset only if its price is within this fraction of the reference
UNIVERSE_MAX_PRICE_DEVIATION=0.15
# Optional. Without a key the public API is used (about 5 calls per minute).
COINGECKO_API_KEY=
# demo | pro (only used when a key is set)
COINGECKO_API_PLAN=demo
# Home page: seconds between CoinGecko polls for coin prices, 7-day charts and global market
# stats (60-3600). Each poll costs 2 calls, shared with the universe build's budget.
OVERVIEW_REFRESH_SEC=120

# ---------------------------------------------------------------- telegram (Stage 4)
# One chat (forum supergroup) with five topics, one bot per topic. Add each bot to the chat
# with permission to post. Leave a token empty to record that scanner's signals without sending.
# TOPIC_ID is the message_thread_id of the forum topic.
TELEGRAM_CHAT_ID=
TELEGRAM_FAIR_PRICE_BOT_TOKEN=
TELEGRAM_FAIR_PRICE_TOPIC_ID=
TELEGRAM_OPEN_INTEREST_BOT_TOKEN=
TELEGRAM_OPEN_INTEREST_TOPIC_ID=
TELEGRAM_FUNDING_BOT_TOKEN=
TELEGRAM_FUNDING_TOPIC_ID=
TELEGRAM_SPREAD_BOT_TOKEN=
TELEGRAM_SPREAD_TOPIC_ID=
TELEGRAM_TWAP_BOT_TOKEN=
TELEGRAM_TWAP_TOPIC_ID=

# ---------------------------------------------------------------- production (docker-compose.prod.yml)
# See docs/deployment.md. In production also set: NODE_ENV=production, LOG_PRETTY=false,
# a strong POSTGRES_PASSWORD (before the first start), DASHBOARD_PASSWORD (12+ characters),
# SESSION_SECRET (32+ random characters). COOKIE_SECURE is forced to true behind Caddy.
# Public host name of the dashboard; its DNS record must point to the server.
DOMAIN=
# Database backups: host directory, days kept, hours between dumps, and whether to include
# the per-minute market snapshots (a 7-day window that refills by itself; most of the data).
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_HOURS=24
BACKUP_INCLUDE_SNAPSHOTS=false
